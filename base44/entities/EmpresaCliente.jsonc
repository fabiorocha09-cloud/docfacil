{
  "name": "EmpresaCliente",
  "type": "object",
  "properties": {
    "contador_email": {
      "type": "string"
    },
    "cnpj": {
      "type": "string"
    },
    "ie": {
      "type": "string"
    },
    "razao_social": {
      "type": "string"
    },
    "nome_fantasia": {
      "type": "string"
    },
    "logradouro": {
      "type": "string"
    },
    "numero": {
      "type": "string"
    },
    "complemento": {
      "type": "string"
    },
    "bairro": {
      "type": "string"
    },
    "municipio": {
      "type": "string"
    },
    "uf": {
      "type": "string"
    },
    "cep": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "regime_tributario": {
      "type": "string",
      "enum": [
        "simples_nacional",
        "lucro_presumido",
        "lucro_real"
      ]
    },
    "inscricao_municipal": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Municipal (ISS) - opcional para empresas que n\u00e3o prestam servi\u00e7os"
    },
    "nfe_ativo": {
      "type": "boolean",
      "default": true
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "nfe_io_company_id": {
      "type": "string",
      "description": "ID da empresa no NFE.io (necess\u00e1rio para emiss\u00e3o)"
    },
    "nfe_ambiente": {
      "type": "string",
      "enum": [
        "homologacao",
        "producao"
      ],
      "default": "homologacao",
      "description": "Ambiente de emiss\u00e3o: homologacao ou producao"
    },
    "nfe_serie": {
      "type": "string",
      "default": "1",
      "description": "S\u00e9rie da NF-e"
    },
    "nfe_ultimo_numero": {
      "type": "number",
      "default": 0,
      "description": "\u00daltimo n\u00famero de NF-e emitida (controle de sequ\u00eancia)"
    }
  },
  "required": [
    "cnpj",
    "razao_social"
  ]
}