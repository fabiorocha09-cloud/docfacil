{
  "name": "Certidao",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "empresa_nome": {
      "type": "string"
    },
    "empresa_cnpj": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "federal",
        "estadual",
        "municipal",
        "fgts",
        "trabalhista",
        "alvara_bombeiros",
        "alvara_vigilancia_sanitaria",
        "alvara_funcionamento",
        "alvara_meio_ambiente"
      ],
      "description": "Tipo da certid\u00e3o ou alvar\u00e1"
    },
    "subtipo": {
      "type": "string",
      "description": "Ex: Receita Federal, PGFN, SEFAZ-PA"
    },
    "status": {
      "type": "string",
      "enum": [
        "regular",
        "irregular",
        "pendente",
        "erro",
        "processando"
      ],
      "default": "pendente"
    },
    "data_emissao": {
      "type": "string",
      "format": "date"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date"
    },
    "arquivo_url": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    },
    "solicitado_por_email": {
      "type": "string",
      "description": "Email de quem solicitou"
    },
    "solicitado_por_nome": {
      "type": "string",
      "description": "Nome de quem solicitou"
    },
    "data_solicitacao": {
      "type": "string",
      "format": "date-time",
      "description": "Quando foi solicitada"
    },
    "prazo_esperado": {
      "type": "string",
      "format": "date",
      "description": "Prazo esperado para recebimento"
    },
    "historico_status": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "data": {
            "type": "string"
          },
          "usuario": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          }
        }
      },
      "description": "Hist\u00f3rico de mudan\u00e7as de status"
    },
    "notificacoes_enviadas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de dias antes do vencimento j\u00e1 notificados: ['30','15','7']"
    },
    "notificacao_irregularidade_enviada": {
      "type": "boolean",
      "default": false,
      "description": "Se j\u00e1 foi enviada notifica\u00e7\u00e3o de irregularidade"
    },
    "excluida": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "empresa_id",
    "tipo",
    "status"
  ]
}