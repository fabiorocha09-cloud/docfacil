{
  "name": "FormaPagamento",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "nome": {
      "type": "string"
    },
    "tipo_transacao": {
      "type": "string",
      "enum": [
        "Normal",
        "POS",
        "D\u00e9bito"
      ],
      "default": "Normal"
    },
    "tipo_pagamento": {
      "type": "string"
    },
