{
  "name": "NotaFiscal55",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "empresa_nome": {
      "type": "string"
    },
    "numero": {
      "type": "number"
    },
    "serie": {
      "type": "string",
      "default": "1"
    },
    "chave_acesso": {
      "type": "string"
    },
    "status_sefaz": {
      "type": "string",
      "enum": [
        "rascunho",
        "validada",
        "transmitindo",
        "transmitida",
        "rejeitada",
        "cancelada"
      ],
      "default": "rascunho"
    },
    "natureza_operacao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da natureza da opera\u00e7\u00e3o"
    },
    "destinatario_id": {
      "type": "string"
    },
    "destinatario_nome": {
      "type": "string"
    },
    "destinatario_cnpj": {
      "type": "string"
    },
    "destinatario_email": {
      "type": "string"
    },
    "dest_logradouro": {
      "type": "string"
    },
    "dest_numero": {
      "type": "string"
    },
    "dest_complemento": {
      "type": "string"
    },
    "dest_bairro": {
      "type": "string"
    },
    "dest_municipio": {
      "type": "string"
    },
    "dest_uf": {
      "type": "string"
    },
    "dest_cep": {
      "type": "string"
    },
    "dest_codigo_municipio": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio do destinat\u00e1rio"
    },
    "dest_ie": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Estadual do destinat\u00e1rio"
    },
    "dest_indicador_ie": {
      "type": "string",
      "enum": [
        "TaxPayer",
        "Exempt",
        "NonTaxPayer"
      ],
      "default": "NonTaxPayer",
      "description": "Indicador da IE do destinat\u00e1rio"
    },
    "forma_pagamento": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da forma de pagamento"
    },
    "forma_pagamento_codigo": {
      "type": "string",
      "default": "01",
      "description": "C\u00f3digo da forma de pagamento (01=Dinheiro, 03=Cart\u00e3o Cr\u00e9dito, 04=Cart\u00e3o D\u00e9bito, 17=PIX)"
    },
    "tipo_cliente": {
      "type": "string",
      "enum": [
        "consumidor_final",
        "revenda"
      ],
      "default": "consumidor_final"
    },
    "regra_tributacao_id": {
      "type": "string"
    },
    "regra_tributacao_nome": {
      "type": "string"
    },
    "valor_produtos": {
      "type": "number",
      "default": 0
    },
    "valor_frete": {
      "type": "number",
      "default": 0
    },
    "valor_seguro": {
      "type": "number",
      "default": 0
    },
    "outras_despesas": {
      "type": "number",
      "default": 0
    },
    "valor_desconto": {
      "type": "number",
      "default": 0
    },
    "valor_impostos": {
      "type": "number",
      "default": 0
    },
    "valor_total": {
      "type": "number",
      "default": 0
    },
    "protocolo": {
      "type": "string"
    },
    "retorno_xml_url": {
      "type": "string"
    },
    "danfe_pdf_url": {
      "type": "string"
    },
    "erros": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "certificado_id": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    },
    "nfe_io_raw": {
      "type": "object",
      "description": "Resposta bruta da API NFE.io para diagn\u00f3stico"
    },
    "log_transmissao": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Hist\u00f3rico de tentativas de transmiss\u00e3o"
    }
  },
  "required": [
    "empresa_id",
    "status_sefaz"
  ]
}