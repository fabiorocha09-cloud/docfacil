{
  "name": "NotaFiscal55",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "empresa_nome": {
      "type": "string"
    },
    "numero": {
      "type": "number"
    },
    "serie": {
      "type": "string",
      "default": "001"
    },
    "chave_acesso": {
      "type": "string"
    },
    "status_sefaz": {
      "type": "string",
      "enum": [
        "rascunho",
        "validada",
        "transmitindo",
        "transmitida",
        "rejeitada",
        "cancelada"
      ],
      "default": "rascunho"
    },
    "destinatario_id": {
      "type": "string"
    },
    "destinatario_nome": {
      "type": "string"
    },
    "destinatario_cnpj": {
      "type": "string"
    },
    "valor_produtos": {
      "type": "number",
      "default": 0
    },
    "valor_impostos": {
      "type": "number",
      "default": 0
    },
    "valor_total": {
      "type": "number",
      "default": 0
    },
    "protocolo": {
      "type": "string"
    },
    "retorno_xml_url": {
      "type": "string"
    },
    "danfe_pdf_url": {
      "type": "string"
    },
    "erros": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "certificado_id": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    },
    "nfe_io_raw": {
      "type": "object",
      "description": "Resposta bruta da API NFE.io para diagn\u00f3stico"
    },
    "log_transmissao": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Hist\u00f3rico de tentativas de transmiss\u00e3o"
    }
  },
  "required": [
    "empresa_id",
    "status_sefaz"
  ]
}