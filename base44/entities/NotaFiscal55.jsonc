{
  "name": "NotaFiscal55",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "empresa_nome": {
      "type": "string"
    },
    "numero": {
      "type": "number"
    },
    "serie": {
      "type": "string",
      "default": "1"
    },
    "chave_acesso": {
      "type": "string"
    },
    "nfe_io_id": {
      "type": "string",
      "description": "ID interno da nota no NFE.io (usado para consultas futuras)"
    },
    "status_sefaz": {
      "type": "string",
      "enum": [
        "rascunho",
        "validada",
        "transmitindo",
        "transmitida",
        "rejeitada",
        "cancelada"
      ],
      "default": "rascunho"
    },
    "natureza_operacao": {
      "type": "string"
    },
    "destinatario_id": {
      "type": "string"
    },
    "destinatario_nome": {
      "type": "string"
    },
    "destinatario_cnpj": {
      "type": "string"
    },
    "destinatario_email": {
      "type": "string"
    },
    "dest_logradouro": {
      "type": "string"
    },
    "dest_numero": {
      "type": "string"
    },
    "dest_complemento": {
      "type": "string"
    },
    "dest_bairro": {
      "type": "string"
    },
    "dest_municipio": {
      "type": "string"
    },
    "dest_uf": {
      "type": "string"
    },
    "dest_cep": {
      "type": "string"
    },
    "dest_codigo_municipio": {
      "type": "string"
    },
    "dest_ie": {
      "type": "string"
    },
    "dest_indicador_ie": {
      "type": "string",
      "enum": [
        "TaxPayer",
        "Exempt",
        "NonTaxPayer"
      ],
      "default": "NonTaxPayer"
    },
    "forma_pagamento": {
      "type": "string"
    },
    "forma_pagamento_codigo": {
      "type": "string",
      "default": "01"
    },
    "tipo_cliente": {
      "type": "string",
      "enum": [
        "consumidor_final",
        "revenda"
      ],
      "default": "consumidor_final"
    },
    "regra_tributacao_id": {
      "type": "string"
    },
    "regra_tributacao_nome": {
      "type": "string"
    },
    "valor_produtos": {
      "type": "number",
      "default": 0
    },
    "valor_frete": {
      "type": "number",
      "default": 0
    },
    "valor_seguro": {
      "type": "number",
      "default": 0
    },
    "outras_despesas": {
      "type": "number",
      "default": 0
    },
    "valor_desconto": {
      "type": "number",
      "default": 0
    },
    "valor_impostos": {
      "type": "number",
      "default": 0
    },
    "valor_total": {
      "type": "number",
      "default": 0
    },
    "protocolo": {
      "type": "string"
    },
    "retorno_xml_url": {
      "type": "string"
    },
    "danfe_pdf_url": {
      "type": "string"
    },
    "erros": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "certificado_id": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    },
    "nfe_io_raw": {
      "type": "object",
      "description": "Resposta bruta da API NFE.io para diagn\u00f3stico"
    },
    "log_transmissao": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Hist\u00f3rico de tentativas de transmiss\u00e3o"
    }
  },
  "required": [
    "empresa_id",
    "status_sefaz"
  ]
}