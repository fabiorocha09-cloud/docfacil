{
  "name": "RegraTributacao",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "nome": {
      "type": "string",
      "description": "Nome do grupo de tributa\u00e7\u00e3o"
    },
    "cfop_estadual": {
      "type": "string"
    },
    "cfop_interestadual": {
      "type": "string"
    },
    "estados": {
      "type": "string",
      "default": "Todos os estados"
    },
    "cliente_revenda": {
      "type": "string"
    },
    "cliente_consumidor_final": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome"
  ]
}