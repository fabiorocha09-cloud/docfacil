{
  "name": "ItemNota",
  "type": "object",
  "properties": {
    "nota_id": {
      "type": "string"
    },
    "empresa_id": {
      "type": "string"
    },
    "produto_id": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "ncm": {
      "type": "string"
    },
    "cfop": {
      "type": "string"
    },
    "unidade": {
      "type": "string",
      "default": "UN"
    },
    "quantidade": {
      "type": "number",
      "default": 1
    },
    "valor_unitario": {
      "type": "number",
      "default": 0
    },
    "valor_total": {
      "type": "number",
      "default": 0
    },
    "origem": {
      "type": "string",
      "default": "0",
      "description": "Origem da mercadoria (0=Nacional, 1=Estrangeira importa\u00e7\u00e3o direta, etc.)"
    },
    "icms_csosn": {
      "type": "string",
      "description": "C\u00f3digo de Situa\u00e7\u00e3o da Opera\u00e7\u00e3o do Simples Nacional"
    },
    "icms_cst": {
      "type": "string",
      "description": "C\u00f3digo de Situa\u00e7\u00e3o Tribut\u00e1ria do ICMS (regime normal)"
    },
    "icms_aliquota": {
      "type": "number",
      "default": 0
    },
    "icms_base": {
      "type": "number",
      "default": 0
    },
    "pis_cst": {
      "type": "string",
      "default": "07",
      "description": "CST do PIS"
    },
    "pis_aliquota": {
      "type": "number",
      "default": 0
    },
    "cofins_cst": {
      "type": "string",
      "default": "07",
      "description": "CST do COFINS"
    },
    "cofins_aliquota": {
      "type": "number",
      "default": 0
    },
    "valor_icms": {
      "type": "number",
      "default": 0
    },
    "valor_pis": {
      "type": "number",
      "default": 0
    },
    "valor_cofins": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "nota_id",
    "descricao"
  ]
}