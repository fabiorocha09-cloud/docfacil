{
  "name": "Contato",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do contato"
    },
    "telefone": {
      "type": "string",
      "description": "N\u00famero de WhatsApp com DDI e DDD, ex: +5591984482625"
    },
    "empresas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "cnpj": {
            "type": "string"
          }
        }
      },
      "description": "Lista de empresas vinculadas a este contato"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "telefone"
  ]
}